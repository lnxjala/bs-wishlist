rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /event/{doc} {
      allow read: if true;
      allow write: if true;
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow write: if true;

      match /reservas/{reservaId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }
  }
}
